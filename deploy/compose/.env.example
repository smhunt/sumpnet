# Copy to .env (make env does this). Every variable must be set: ChirpStack
# substitutes $VAR in its TOML only for variables that exist.
COMPOSE_PROJECT_NAME=sumpnet
LOG_LEVEL=info

# Published host ports. Mac dev host values are registered in ~/.claude/PORTS.md;
# the lab VM can use defaults (5432/1883/8080) here instead.
POSTGRES_PORT=5444
MQTT_PORT=3133
CHIRPSTACK_PORT=3131
API_PORT=3134
WEB_PORT=3034
ALERTS_GRPC_PORT=3135
GW_UDP_PORT=1700

# Alert email via a transactional SMTP provider (SMTP2GO, SendGrid, Postmark, SES SMTP).
# Leave SMTP_HOST empty to log alerts instead of emailing. 587 = STARTTLS, 465 = implicit TLS.
# SMTP_PASSWORD is the provider API key: real values live only in the gitignored .env.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@example.com
SMTP_TLS=auto
ALERTS_TO=operator@example.com

# Local-only credentials.
POSTGRES_PASSWORD=sumpnet
CHIRPSTACK_DB_PASSWORD=chirpstack
# Generate with: openssl rand -base64 32
CHIRPSTACK_API_SECRET=replace-me-with-openssl-rand-base64-32
