# Copy to .env (make env does this). Every variable must be set: ChirpStack
# substitutes $VAR in its TOML only for variables that exist.
COMPOSE_PROJECT_NAME=sumpnet
LOG_LEVEL=info

# Published host ports. Mac dev host values are registered in ~/.claude/PORTS.md;
# the lab VM can use defaults (5432/1883/8080) here instead.
POSTGRES_PORT=5444
MQTT_PORT=3133
CHIRPSTACK_PORT=3131
API_PORT=3134
WEB_PORT=3034
ALERTS_GRPC_PORT=3135
GW_UDP_PORT=1700

# Alert email via a transactional SMTP provider. The default provider is Resend:
#   SMTP_HOST=smtp.resend.com  SMTP_PORT=465  SMTP_USER=resend  SMTP_PASSWORD=re_...(API key)
#   SMTP_FROM must use a domain verified in Resend (onboarding@resend.dev only
#   delivers to the Resend account owner's own address).
# Any other SMTP provider works too (SMTP2GO, SendGrid, Postmark, SES SMTP).
# Leave SMTP_HOST empty to log alerts instead of emailing. 587 = STARTTLS, 465 = implicit TLS.
# SMTP_PASSWORD is the provider API key: real values live only in the gitignored .env.
# Check delivery with: make alerts-testmail
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@example.com
SMTP_TLS=auto
ALERTS_TO=operator@example.com

# Weather (Phase 4): ECCC hourly climate observations via MSC GeoMet, the
# fallback and cross-check for the rain gauges. 6144478 = LONDON CS, the nearest
# station with hourly precipitation (LONDON A reports none). Set
# WEATHER_ECCC_ENABLED=false when replaying simulated storms.
WEATHER_ECCC_ENABLED=true
WEATHER_ECCC_STATION=6144478
WEATHER_ECCC_POLL_INTERVAL=1h
WEATHER_ECCC_BACKFILL=168h
WEATHER_ECCC_LOOKBACK=48h

# Local-only credentials.
POSTGRES_PASSWORD=sumpnet
CHIRPSTACK_DB_PASSWORD=chirpstack
# Generate with: openssl rand -base64 32
CHIRPSTACK_API_SECRET=replace-me-with-openssl-rand-base64-32
