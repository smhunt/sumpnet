# Copy to .env (make env does this). Every variable must be set: ChirpStack
# substitutes $VAR in its TOML only for variables that exist.
COMPOSE_PROJECT_NAME=sumpnet
LOG_LEVEL=info

# Published host ports. Mac dev host values are registered in ~/.claude/PORTS.md;
# the lab VM can use defaults (5432/1883/8080) here instead.
POSTGRES_PORT=5444
MQTT_PORT=3133
CHIRPSTACK_PORT=3131
API_PORT=3134
WEB_PORT=3034
ALERTS_GRPC_PORT=3135
GW_UDP_PORT=1700

# Alert email via a transactional SMTP provider. The default provider is Resend:
#   SMTP_HOST=smtp.resend.com  SMTP_PORT=465  SMTP_USER=resend  SMTP_PASSWORD=re_...(API key)
#   SMTP_FROM must use a domain verified in Resend (onboarding@resend.dev only
#   delivers to the Resend account owner's own address).
# Any other SMTP provider works too (SMTP2GO, SendGrid, Postmark, SES SMTP).
# Leave SMTP_HOST empty to log alerts instead of emailing. 587 = STARTTLS, 465 = implicit TLS.
# SMTP_PASSWORD is the provider API key: real values live only in the gitignored .env.
# Check delivery with: make alerts-testmail
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@example.com
SMTP_TLS=auto
ALERTS_TO=operator@example.com

# Local-only credentials.
POSTGRES_PASSWORD=sumpnet
CHIRPSTACK_DB_PASSWORD=chirpstack
# Generate with: openssl rand -base64 32
CHIRPSTACK_API_SECRET=replace-me-with-openssl-rand-base64-32

# --- api-gateway + dashboard (Phase 5) ---------------------------------------
# Owner sign-in is Clerk. From the Clerk dashboard (API keys page):
#   CLERK_ISSUER = the Frontend API URL, e.g. https://clerk.ecoworks.ca or
#                  https://<slug>.clerk.accounts.dev (JWKS: <issuer>/.well-known/jwks.json)
#   CLERK_AUTHORIZED_PARTIES = the dashboard origin(s) Clerk puts in the azp claim
# Leave CLERK_ISSUER empty to run public views only. The publishable key for the
# web app goes in web/.env.local (VITE_CLERK_PUBLISHABLE_KEY), not here.
CLERK_ISSUER=
CLERK_JWKS_URL=
CLERK_AUTHORIZED_PARTIES=https://dev.ecoworks.ca:3034
# Browser origin allowed to call the REST API directly (CORS).
WEB_ORIGIN=https://dev.ecoworks.ca:3034
# Shared mkcert certificate for https://dev.ecoworks.ca:${API_PORT} (cert.pem, key.pem).
TLS_CERT_DIR=~/Code/.traefik/certs
# Live segment status window, ending at the newest heartbeat event time.
STATUS_WINDOW=1h
# make seed: link this Clerk user id (user_...) to simulated home 0.
DEMO_OWNER_SUBJECT=
