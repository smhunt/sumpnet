# Copy to web/.env.local (gitignored) and fill in.
# Clerk dashboard -> API keys -> Publishable key (pk_test_... / pk_live_...).
# Empty: the dashboard runs public views only, with sign-in hidden.
VITE_CLERK_PUBLISHABLE_KEY=
# Where the dev server proxies /v1: the api-gateway REST port. Use http:// if the
# gateway runs without the mkcert certificate.
API_PROXY_TARGET=https://localhost:3134
# Optional: call the gateway directly (e.g. https://dev.ecoworks.ca:3134) instead
# of the same-origin /v1 proxy; the gateway must allow this origin (WEB_ORIGIN).
VITE_API_BASE_URL=
# Base map raster tiles. OpenStreetMap's tiles suit light development use only
# (https://operations.osmfoundation.org/policies/tiles/); switch provider for a pilot.
VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_TILE_ATTRIBUTION=© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
